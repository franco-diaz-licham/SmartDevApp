        "applicationInsights": {
          "ingestionMode": "LogAnalytics",
          "kind": "web",
          "applicationType": "web",
          "requestSource": "rest",
          "flowType": "Bluefield"
        }
      }
    },
    "serviceBusConfiguration": {
      "value": {
        "queue": {
          "requiresSession": false,
          "deadLetteringOnMessageExpiration": true,
          "enablePartitioning": false,
          "enableBatchedOperations": true,
          "lockDuration": "PT1M",
          "defaultMessageTimeToLive": "PT1H",
          "maxDeliveryCount": 5,
          "requiresDuplicateDetection": false
        },
        "location": "australiaeast",
        "publicNetworkAccess": "Enabled",
        "minimumTlsVersion": "1.2",
        "sku": {
          "name": "Basic",
          "tier": "Basic"
        },
        "authorizationRule": {
          "name": "SmartDevFunctionApps",
          "rights": [
            "Listen",
            "Send"
          ]
        },
        "queues": {
          "contactEmailDeliveryResult": "contact-email-delivery-result",
          "articleNarrationRequested": "article-narration-requested",
          "contactMessageCreated": "contact-message-created"
        }
      }
    },
    "storageConfiguration": {
      "value": {
        "skuName": "Standard_LRS",
        "containerPublicAccess": "None",
        "supportsHttpsTrafficOnly": true,
        "location": "australiaeast",
        "articleAudioContainerName": "article-audio",
        "blobDeleteRetentionPolicy": {
          "days": 7,
          "enabled": true
        },
        "containerDeleteRetentionPolicy": {
          "days": 7,
          "enabled": true
        },
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "kind": "StorageV2",
        "accessTier": "Hot",
        "deploymentContainerNames": [
          "api-functions-deployments",
          "worker-functions-deployments"
        ]
      }
