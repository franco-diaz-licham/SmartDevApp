    "resourceNameConfiguration": {
      "value": {
        "apiFunctionApp": "smartdevapp-api-af",
        "apiServicePlan": "ASP-SmartDevApp-a0fb",
        "appInsights": "smartdevapp-ai",
        "communicationService": "SmartDevApp",
        "cosmosAccount": "smartdevapp-cdb",
        "emailService": "SmartDevApp",
        "keyVault": "smartdevapp-kv",
        "keyVaultReferenceIdentity": "smartdevapp-kv-ref-mi",
        "logAnalyticsWorkspace": "smartdevapp-law",
        "serviceBusNamespace": "smartdevappsb",
        "speechService": "smartdevapp-speech",
        "staticWebApp": "SmartDevApp",
        "storageAccount": "smartdevappsa",
        "workerFunctionApp": "smartdevapp-worker-af",
        "workerServicePlan": "ASP-SmartDevApp-91b9"
      }
    }
  }
}
