{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "canadacentral"
    },
    "workloadName": {
      "value": "smartdevapp"
    },
    "environmentName": {
      "value": "dev"
    },
    "tags": {
      "value": {
        "owner": "smartdevapp"
      }
    },
    "staticWebAppConfig": {
      "value": {
        "location": "eastus2",
        "skuName": "Free",
        "skuTier": "Free"
      }
    },
    "dnsConfig": {
      "value": {
        "zoneName": ""
      }
    },
    "communicationConfig": {
      "value": {
        "dataLocation": "Australia"
      }
    },
    "cosmosConfig": {
      "value": {
        "databaseName": "smartdev",
        "throughput": 400,
        "contactMessageTtlSeconds": 86400
      }
    },
    "apiConfig": {
      "value": {
        "functionRuntimeVersion": "10.0",
        "maximumInstanceCount": 10,
        "functionInstanceMemoryMB": 2048,
        "httpPerInstanceConcurrency": 16
      }
    },
    "workerConfig": {
      "value": {
        "maximumInstanceCount": 5
      }
    },
    "keyVaultConfig": {
      "value": {
        "softDeleteRetentionInDays": 7
      }
    },
    "observabilityConfig": {
      "value": {
        "retentionInDays": 30,
        "dailyQuotaGb": 1
      }
    },
    "serviceBusConfig": {
      "value": {
        "skuName": "Standard",
        "skuTier": "Standard"
      }
    },
    "storageConfig": {
      "value": {
        "skuName": "Standard_LRS"
      }
    }
  }
}
