{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "australiaeast"
    },
    "workloadName": {
      "value": "smartdevapp"
    },
    "environmentName": {
      "value": "dev"
    },
    "tags": {
      "value": {
        "owner": "smartdevapp"
      }
    },
    "staticWebAppConfiguration": {
      "value": {
        "location": "eastasia",
        "sku": {
          "name": "Free",
          "tier": "Free"
        }
      }
    },
    "dnsConfiguration": {
      "value": {
        "zoneName": "smartdev.com.au"
      }
    },
    "communicationConfiguration": {
      "value": {
        "userEngagementTracking": "Disabled",
        "location": "global",
        "managedDomainName": "AzureManagedDomain",
        "domainManagement": "AzureManaged",
        "publicNetworkAccess": "Enabled",
        "dataLocation": "Australia"
      }
    },
    "speechConfiguration": {
      "value": {
        "enabled": true,
        "kind": "SpeechServices",
        "location": "australiaeast",
        "sku": {
          "name": "F0"
        },
        "customSubDomainName": "smartdevapp-speech",
        "publicNetworkAccess": "Enabled",
        "voiceName": "en-AU-NatashaNeural"
      }
    },
    "cosmosConfiguration": {
      "value": {
        "databaseName": "smartdev",
        "serverless": false,
        "throughput": 1000,
        "contactMessageTtlSeconds": 86400,
        "kind": "GlobalDocumentDB",
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "databaseAccountOfferType": "Standard",
        "enableAutomaticFailover": true,
        "enableFreeTier": true,
        "serverlessCapabilities": [],
        "locations": [
          {
            "locationName": "australiaeast",
            "failoverPriority": 0,
            "isZoneRedundant": false
          }
        ],
        "publicNetworkAccess": "Enabled",
        "containers": {
          "contactMessages": {
            "partitionKey": {
              "paths": [
                "/partitionKey"
              ],
              "kind": "Hash"
            },
            "defaultTtl": 86400,
            "name": "contact-messages"
          },
          "articles": {
            "name": "articles",
            "partitionKey": {
              "paths": [
                "/partitionKey"
              ],
              "kind": "Hash"
            }
          }
        }
      }
    },
    "apiFunctionConfiguration": {
      "value": {
        "runtime": {
          "environmentName": "Production",
          "name": "dotnet-isolated",
          "extensionVersion": "~4",
          "version": "10"
        },
        "location": "australiaeast",
        "plan": {
          "reserved": true,
          "skuTier": "FlexConsumption",
          "kind": "functionapp",
          "skuName": "FC1"
        },
        "scale": {
          "maximumInstanceCount": 1,
          "instanceMemoryMB": 512,
          "httpPerInstanceConcurrency": 4
        },
        "site": {
          "httpsOnly": true,
          "ftpsState": "Disabled",
          "identityType": "SystemAssigned",
          "kind": "functionapp,linux",
          "minimumTlsVersion": "1.2"
        },
        "deployment": {
          "storageConnectionSettingName": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
          "authenticationType": "StorageAccountConnectionString",
          "storageType": "blobContainer",
          "containerName": "api-functions-deployments"
        },
        "loggingServiceName": "SmartDev.Api.Functions"
      }
    },
    "workerFunctionConfiguration": {
      "value": {
        "runtime": {
          "environmentName": "Production",
          "name": "dotnet-isolated",
          "extensionVersion": "~4",
          "version": "10"
        },
        "location": "australiaeast",
        "plan": {
          "reserved": true,
          "skuTier": "FlexConsumption",
          "kind": "functionapp",
          "skuName": "FC1"
        },
        "scale": {
          "maximumInstanceCount": 1,
          "instanceMemoryMB": 512,
          "httpPerInstanceConcurrency": 0
        },
        "site": {
          "httpsOnly": true,
          "ftpsState": "Disabled",
          "identityType": "SystemAssigned",
          "kind": "functionapp,linux",
          "minimumTlsVersion": "1.2"
        },
        "deployment": {
          "storageConnectionSettingName": "DEPLOYMENT_STORAGE_CONNECTION_STRING",
          "authenticationType": "StorageAccountConnectionString",
          "storageType": "blobContainer",
          "containerName": "worker-functions-deployments"
        },
        "loggingServiceName": "SmartDev.Worker.Functions"
      }
    },
    "keyVaultConfiguration": {
      "value": {
        "sku": {
          "name": "standard",
          "family": "A"
        },
        "location": "australiaeast",
        "secrets": {
          "azureWebJobsStorage": "AzureWebJobsStorage",
          "azureCommunicationServiceConnectionString": "AzureCommunicationServiceConnectionString",
          "azureSpeechSubscriptionKey": "AzureSpeechSubscriptionKey",
          "cosmosDbConnectionString": "CosmosDbConnectionString",
          "communicationSenderAddress": "AzureCommunicationServiceSenderAddress",
          "azureServiceBus": "AzureServiceBus"
